# NOCTURNE — Environment Variables
# Copy this to .env and fill in your real values.
# Never commit .env to version control.

# ── Bitget API ──────────────────────────────
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_API_PASSPHRASE=your_passphrase_here
BITGET_USE_SANDBOX=true

# ── LLM ─────────────────────────────────────
# Set LLM_PROVIDER to "fireworks", "openai", or "anthropic"
# Note: If FIREWORKS_API_KEY is set, Fireworks is auto-selected!
LLM_PROVIDER=fireworks
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_MODEL=accounts/fireworks/models/qwen2p5-72b-instruct
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Or use OpenAI instead:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_key_here

# Or use Anthropic instead:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-haiku-20240307
# ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Database ─────────────────────────────────
# SQLite (default — no setup required):
DATABASE_URL=sqlite+aiosqlite:///nocturne.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nocturne

# ── Redis (optional) ─────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ── Risk Limits ──────────────────────────────
MAX_SPREAD_MULTIPLIER=2.0
MAX_VOLATILITY_MULTIPLIER=2.5
MIN_DEPTH_RATIO=0.4
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_PER_TRADE_RISK_PCT=0.005
MAX_CONSECUTIVE_LOSSES=3

# ── Weather Score Weights ────────────────────
WEIGHT_SPREAD=0.30
WEIGHT_DEPTH=0.25
WEIGHT_VOLATILITY=0.25
WEIGHT_LEAD_LAG=0.10
WEIGHT_EVENT=0.10

# ── Score Thresholds ─────────────────────────
CLEAR_THRESHOLD=70.0
CLOUDY_THRESHOLD=45.0
STORM_THRESHOLD=20.0

# ── App ──────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
WEATHER_POLL_SECONDS=30
